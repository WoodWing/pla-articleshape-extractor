{
    "files.associations": {
        "*.idjs": "javascript"
    },
    "cSpell.words": [
        "aila",
        "idms",
        "idjs",
        "indesign",
        "layouter",
        "ltrim",
        "malpositioned",
        "outerbound",
        "prefs",
        "rtrim",
        "stroustrup",
        "ungroup"
    ],
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "eslint.format.enable": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "eslint.validate": [
        "javascript"
    ]
}