await (async function main () {
    const idd = require("indesign");
    const initBootstrap = require("../bootstrap.js");
    const Container = require("../modules/Container.cjs");
    const Errors = require("../modules/Errors.cjs");
    try {
        initBootstrap();

        if (idd.app.documents.length === 0) {
            throw new Errors.NoDocumentOpenedError();
        }

        const doc = idd.app.activeDocument;
        if (doc.articles.length === 0) {
            throw new Errors.NoArticlesInDocumentError();
        }

        // Prompt the user to select the folder for saving the snippets.
        alert("Select a folder to save the Article Shapes.");
        const lfs = require("uxp").storage.localFileSystem;
        const domains = require("uxp").storage.domains;
        const folder = await lfs.getFolder({ initialDomain: domains.userDocuments });
        if (!folder || !folder.isFolder) {
            throw new Errors.NoFolderSelectedError();
        }

        // Resolve the brand and sections and save them to disk.
        const mapResolver = /** @type BrandSectionMapResolver */(Container.resolve("BrandSectionMapResolver"));
        await mapResolver.run(folder);

        // Resolve the genres and save them to disk.
        const genreResolver = /** @type GenreResolver */(Container.resolve("GenreResolver"));
        await genreResolver.saveGenesToManifest(folder);

        // Export article shapes to disk.
        const exporter = /** @type ExportInDesignArticlesToFolder */(Container.resolve("ExportInDesignArticlesToFolder"));
        let exportCounter = await exporter.run(doc, folder);
        if (exportCounter === 0) {
            throw new Errors.PrintLayoutAutomationError("No articles exported. Check if articles are properly named and have frames defined.");
        }
        alert(exportCounter + " articles have been exported as Article Shapes.");
    }
    catch (error) {
        const logger = /** @type Logger */ (Container.resolve("Logger"));
        logger.logError(error);
        alert(error.message, "Error");
    }
})();
