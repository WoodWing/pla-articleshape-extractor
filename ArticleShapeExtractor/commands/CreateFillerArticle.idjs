await (async function main () {
    const initBootstrap = require("../bootstrap.js");
    const Container = require("../modules/Container.cjs");

    try {
        initBootstrap();
        const articleService = /** @type InDesignArticleService */(Container.resolve("InDesignArticleService"));
        articleService.addOrRenameInDesignArticle("Filler");
    }
    catch (error) {
        const logger = /** @type Logger */ (Container.resolve("Logger"));
        logger.logError(error);
        alert(error.message, "Error");
    }
})();
