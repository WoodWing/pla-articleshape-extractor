{
  "compilerOptions": {
    "moduleResolution": "node",
    
    // For Node and VS Code. Does not apply to InDesign host.
    "target": "esnext",

    // Process JS files. Let VS Code understand require() AND import.
    "allowJs": true,

    // Type checking on JS code. Applies to tsc and VS Code.
    //"checkJs": true, // TODO

    // Strict mode for JS code validation. Applies to tsc and VS Code.
    //"strict": true, // TODO

    // Make UXP types available for VS Code.
    "typeRoots": [
      "node_modules/@types",
      "node_modules/uxp-types"
    ],

    // No fake path aliases.
    "baseUrl": ".", // root folder
    
    // JS scripts do not run in a browser (DOM) but in InDesign, hence turn off lib.dom.d.ts.
    // Note that both web browser DOM and InDesign define e.g. a global Document.
    // This option excludes the DOM and so the InDesign Document definition is used.
    // See doc/DEVELOPMENT.md how to manage.
    "noLib": true,
    
    "paths": {
      "*": ["./*"]
    }
  },
  "include": [
    "./**/*.cjs",
    "./**/*.mjs",
    "./**/*.idjs",
    "./**/*.js",
    "types/adobe/InDesign/2023/*.d.ts",
    "types/adobe/shared/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}