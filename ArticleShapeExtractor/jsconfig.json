{
  "compilerOptions": {
    "moduleResolution": "node",
    
    // VS Code only — not runtime
    "target": "esnext",

    // Let VS Code understand require() AND import
    "allowJs": true,

    // No fake path aliases
    "baseUrl": ".", // root folder
    
    "paths": {
      "*": ["./*"]
    }
  },
  "include": [
    "./**/*.cjs",
    "./**/*.mjs",
    "./**/*.idjs",
    "./**/*.js"
  ]
}